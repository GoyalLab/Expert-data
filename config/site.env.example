# Site configuration for ExPert-data -- copy to `.env.site` (git-ignored) and edit,
# then `source .env.site` before running the pipeline or any scripts/run_*.sh.
#
# Every path below has a repo-relative default, so the pipeline runs out of the box on a
# workstation; these overrides point it at cluster storage instead.

# --- storage -----------------------------------------------------------------
export EXPERT_CACHE_DIR=/path/to/perturb-seq/data      # raw downloads + sidecars
export EXPERT_STORE_DIR=/path/to/perturb-seq/store     # canonical store (DATASET_HASH)
export EXPERT_OUTPUT_DIR=/path/to/data/store_out       # materialised DBs (RECIPE_HASH)
export EXPERT_FIXTURE_DIR=/path/to/perturb-seq/fixture # small test fixture
# export EXPERT_PUBLISH_DIR=/path/to/published/source  # upload_*.sh sources
# export EXPERT_INFERENCE_DIR=/path/to/inference       # external query datasets
# export EXPERT_GENE_DB=/path/to/ExPert-model/resources/gene_embeddings/.../gene_source_database.json

# --- scheduler (sbatch reads these directly) ----------------------------------
export SBATCH_ACCOUNT=your_account
export SBATCH_PARTITION=your_partition
export SLURM_ACCOUNT=$SBATCH_ACCOUNT    # consumed by config/*.yaml resources.account

# --- environment --------------------------------------------------------------
export EXPERT_ENV=ExPert                # conda/mamba env name used by scripts/run_*.sh
